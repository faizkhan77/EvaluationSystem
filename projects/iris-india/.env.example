# Copy to .env and fill in from the iris-india project's own API keys
# (Langfuse dashboard -> Settings -> API Keys), NOT the org-level init keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# LLM judge — temporary: can reuse IRIS India's own ApiLens proxy credentials
# (agents/config/model.py in irisbackend-india) until the eval system gets
# its own dedicated key. Swap these two values only when that's ready.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
JUDGE_MODEL=claude-haiku-4-5-20251001

# Golden-dataset replay only (run_golden_dataset.py) — a real IRIS India
# test account, used purely to log in and send test queries.
IRIS_TEST_EMAIL=
IRIS_TEST_PASSWORD=
