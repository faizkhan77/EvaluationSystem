# Copy this file to .env and fill in real values before running `docker compose up`.
# .env itself is gitignored — never commit real secrets.

# --- Core secrets ---
# Generate each with: openssl rand -hex 32   (or -hex 16 for the shorter ones below)
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=

# IMPORTANT: docker-compose.yml's LANGFUSE_S3_*_SECRET_ACCESS_KEY defaults are all
# hardcoded to the literal "miniosecret", they do NOT auto-build from
# MINIO_ROOT_PASSWORD above. Must match it explicitly (same value as
# MINIO_ROOT_PASSWORD) or every trace/media/export upload to MinIO fails with an
# S3 signature mismatch.
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=<same value as MINIO_ROOT_PASSWORD>
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=<same value as MINIO_ROOT_PASSWORD>
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=<same value as MINIO_ROOT_PASSWORD>

# IMPORTANT: docker-compose.yml's DATABASE_URL default hardcodes "postgres:postgres"
# as the password, it does NOT auto-build from POSTGRES_PASSWORD above. You must set
# this explicitly, using the SAME password as POSTGRES_PASSWORD, or langfuse-web/
# langfuse-worker fail to authenticate against Postgres on boot.
DATABASE_URL=postgresql://postgres:<same value as POSTGRES_PASSWORD>@postgres:5432/postgres

# --- Auto-provisioning on first boot ---
# Creates one Org and its first Project automatically so you don't have to click
# through the signup/setup wizard. Every ADDITIONAL Nuqi product that wants its own
# eval system becomes another Project inside this SAME Org (Settings -> Projects ->
# New in the UI) — not a new deployment, not a new database.
LANGFUSE_INIT_ORG_ID=nuqi
LANGFUSE_INIT_ORG_NAME=Nuqi
LANGFUSE_INIT_PROJECT_ID=iris-india
LANGFUSE_INIT_PROJECT_NAME=IRIS India
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# --- Evaluation runner: IRIS India ---
# Langfuse project keys for iris-india (Settings -> API Keys in the dashboard)
IRIS_INDIA_LANGFUSE_PUBLIC_KEY=
IRIS_INDIA_LANGFUSE_SECRET_KEY=
# LLM judge — can reuse IRIS India's ApiLens proxy key until a dedicated one is issued
IRIS_INDIA_ANTHROPIC_API_KEY=
IRIS_INDIA_ANTHROPIC_BASE_URL=
IRIS_INDIA_JUDGE_MODEL=claude-haiku-4-5-20251001
# How often to run evaluations (hours, default 1)
IRIS_INDIA_EVAL_INTERVAL_HOURS=1
# IRIS India backend URL — for golden dataset replay only
IRIS_INDIA_API_URL=http://your-iris-india-server:8000
IRIS_INDIA_TEST_EMAIL=
IRIS_INDIA_TEST_PASSWORD=

# --- Evaluation runner: IRIS Dubai ---
# Langfuse project keys for iris-dubai (create a second project in the dashboard)
IRIS_DUBAI_LANGFUSE_PUBLIC_KEY=
IRIS_DUBAI_LANGFUSE_SECRET_KEY=
IRIS_DUBAI_ANTHROPIC_API_KEY=
IRIS_DUBAI_ANTHROPIC_BASE_URL=
IRIS_DUBAI_JUDGE_MODEL=claude-haiku-4-5-20251001
IRIS_DUBAI_EVAL_INTERVAL_HOURS=1
# IRIS Dubai backend URL — for golden dataset replay only
IRIS_DUBAI_API_URL=http://your-iris-dubai-server:8000
IRIS_DUBAI_TEST_EMAIL=
IRIS_DUBAI_TEST_PASSWORD=
