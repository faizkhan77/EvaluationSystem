# Copy to .env and fill in from the iris-dubai project's own API keys
# (Langfuse dashboard -> Settings -> API Keys), NOT the org-level init keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# LLM judge credentials — can reuse IRIS Dubai's own ApiLens proxy credentials
# until the eval system gets its own dedicated key.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
JUDGE_MODEL=claude-haiku-4-5-20251001

# Golden-dataset replay only (run_golden_dataset.py) — a real IRIS Dubai
# test account, used purely to log in and send test queries.
IRIS_TEST_EMAIL=
IRIS_TEST_PASSWORD=
IRIS_API_URL=http://localhost:8000
